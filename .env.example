# Copy to .env for local runs. On the host, set these in the project settings instead.

# Postgres connection string (Neon). Leave empty locally to use a SQLite file (local.db).
DATABASE_URL=
# Random string (32+ characters) used to sign login tokens. Required when deployed: the app refuses to
# start without it. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Password for every demo account (listed in the README). Defaults to demo1234 if empty.
DEMO_PASSWORD=
# Google Gemini key for the booking/change assistant. Empty = assistant uses keyword rules only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Velo's agent (tool calling). groq or gemini; empty = groq when GROQ_API_KEY is set, else gemini.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Model rounds per message, retries on rate limits or server errors, and seconds per agent call.
AGENT_MAX_STEPS=5
AGENT_RETRIES=2
AGENT_TIMEOUT_S=20
# Minutes before an idle Velo conversation starts fresh, and before an unconfirmed action expires.
VELO_CONTEXT_TTL_MIN=120
VELO_ACTION_TTL_MIN=15
# Seconds per LLM call before falling back to the keyword rules.
LLM_TIMEOUT_S=8
# Solver time limit (seconds) for timetable generation and repair, and CPU threads it may use.
SOLVER_TIME_LIMIT_S=60
SOLVER_WORKERS=8
# Team name written into exported schedule.json files.
TEAM_NAME=Velora

# Frontend build only (frontend/.env.local, or the host's build settings): the password the login page's
# one-click demo buttons use. Set it only if DEMO_PASSWORD above isn't demo1234.
VITE_DEMO_PASSWORD=
