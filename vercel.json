{
  "services": {
    "api": {
      "root": "./",
      "framework": "fastapi",
      "functions": {
        "**/*.py": {
          "maxDuration": 300,
          "excludeFiles": "{frontend/**,backend/tests/**,docs/**,exports/**,scripts/**,starter_pack/data/csv/**,*.pdf}"
        }
      }
    },
    "web": {
      "root": "frontend/",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
